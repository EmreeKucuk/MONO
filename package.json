{
  "name": "mono-workspace",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "node build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/verify-live-rls.mjs",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:start": "electron desktop/main.mjs",
    "desktop:build": "electron-builder --win nsis",
    "test:desktop": "node --test tests/desktop.integration.mjs",
    "predesktop:build": "node scripts/desktop-prepare.mjs"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.mono.dashboard",
    "productName": "MONO",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "desktop/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "description": "MONO personal workspace desktop companion",
  "author": "MONO"
}
